# =====================================================================
# 3주차 에이전트 프로토콜 실습 — 환경변수 샘플
# 사용법:  cp .env_sample .env   후 빈 값 채우기
# =====================================================================

# --- LLM 키 (노트북마다 사용하는 모델이 다름) -------------------------
ANTHROPIC_API_KEY=          # MCP/ACP 노트북 (claude-sonnet-4-6 등)
OPENAI_API_KEY=             # A2A 노트북 graph.py (gpt-3.5-turbo)
GOOGLE_API_KEY=             # ACP 예제 (google_genai:gemini-3.5-flash) 사용 시

# --- MCP (01) ---------------------------------------------------------
# §2,§3 의 인증 없는 FastMCP 서버는 토큰이 필요 없음.
# §4 "실제 인증 테스트" 의 weather 서버(scripts/mcp/weather_server.py)가
# 검증하는 기대 토큰. 서버와 클라이언트가 같은 값을 쓰면 통과한다.
# 비워 두면 양쪽 모두 기본값 'demo-secret-token' 을 쓴다.
MCP_SERVER_TOKEN=demo-secret-token
# (선택) §4 weather 서버 리스닝 포트 — 기본 8000
# MCP_WEATHER_PORT=8000

# --- A2A (03) ---------------------------------------------------------
# `langgraph dev` 로 두 에이전트를 띄운 뒤 assistant id 를 채운다.
AGENT_A_ID=
AGENT_B_ID=

# --- LangSmith 분산 트레이싱 (03, 선택) -------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week3-protocols
LANGSMITH_TRACING=true
